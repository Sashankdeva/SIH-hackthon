# Copy to .env and adjust. Nothing here is loaded automatically by the
# app — app/config.py reads these from the real process environment. Use
# your shell, a process manager, or `python -m dotenv run -- ...` if you
# want a .env file to actually be applied.

# --- Network binding -------------------------------------------------

# 127.0.0.1 = loopback only, unreachable from other machines. This is
# the safe default and matches every run command in this repo's
# history. Set to 0.0.0.0 to accept connections from any interface, or
# to this machine's own LAN IP (ipconfig / ifconfig) to bind only that
# one — see README.md, "Running on the LAN."
HOST=127.0.0.1

# Port the FastAPI app listens on.
PORT=8787

# --- Reasoning backend -------------------------------------------------

# "stub" (default): no GPU, no running model, always proposes a
# harmless "wait" — zero setup for anyone who doesn't need real
# reasoning. "ollama": routes through the local Ollama instance below.
REASONING_BACKEND=stub

# Model tag as pulled in Ollama (`ollama pull qwen2.5:7b-instruct`).
OLLAMA_MODEL=qwen2.5:7b-instruct

# Where THIS SERVER PROCESS reaches Ollama. Leave this at localhost —
# Ollama should keep listening on loopback only, even when FastAPI
# itself is bound to a LAN-facing HOST above. Nothing in this project's
# extension or any other machine ever needs to reach Ollama directly;
# every request goes through this FastAPI server first.
OLLAMA_BASE_URL=http://localhost:11434

# Generous on purpose: a cold Ollama pages the model into VRAM before
# emitting a token (~30s cold, ~2-5s warm, measured on this project's
# hardware). Too short turns a normal first request into a spurious
# "model unavailable".
OLLAMA_TIMEOUT_S=60

# --- Request limits ----------------------------------------------------

# /reason and /complete bodies larger than this get HTTP 413, rejected
# before parsing or any model call. Real payloads measured 120-1100
# bytes in this project's own logs — 64 KiB leaves generous headroom for
# a page with many elements or a long step history while still bounding
# what a single request can cost before it's even validated.
# Safe default: 65536. Same value for development and hosted use — this
# isn't a security control that needs tightening for deployment, just a
# resource bound.
MAX_REQUEST_BODY_BYTES=65536

# --- Authentication ------------------------------------------------------

# Shared secret required in the `X-API-Key` header on every /reason and
# /complete request once set. /health is never gated.
#
# Safe default: empty/unset — authentication DISABLED. A teammate running
# the stub backend locally gets zero setup, exactly like every other
# default in this file.
# Development value: leave empty on a single developer's own machine.
# Hosted value: set to a long, random value (e.g. `openssl rand -hex 32`)
# on any LLM-host laptop reachable from another machine. Missing or wrong
# keys are both rejected with the same 401 — the server never reveals
# which failure mode a caller hit. The key is never logged, never
# returned in an error response, and compared using a constant-time
# comparison (see app/auth.py). Generate your own value — never commit a
# real key to this repository, including in this file.
API_KEY=

# --- Audit logging -------------------------------------------------------

# Controls whether RequestInspectorMiddleware (app/middleware.py) persists
# the FULL parsed request body to server/logs/reason_requests.jsonl, in
# addition to the hash/size/status/timing metadata it ALWAYS records
# regardless of this setting.
#
# Safe default: false. Hash + size + status + timing are enough to prove
# a payload's identity and how the server handled it (the "canary" proof
# that redaction ran) without ever persisting its content — this is what
# a hosted, multi-client deployment should run with.
# Development value: false, unless you are personally running a
# controlled privacy demonstration on your OWN machine with SYNTHETIC
# data you put there yourself, and want to see the exact redacted
# payload the server received. Never enable this against real user data,
# and never enable it on a server anyone else's traffic reaches — a
# request that gets rejected for containing a raw, unsanitized secret is
# rejected BECAUSE the secret is right there in the body, and enabling
# this setting persists that same body to disk before the rejection
# response is ever sent.
# Hosted value: false. There is no hosted scenario where true is correct.
LOG_FULL_REQUEST_BODY=false

# --- CORS ------------------------------------------------------------

# Comma-separated list of origins allowed to read this server's
# responses from browser JavaScript (fetch/XHR). Enforced by the
# BROWSER, not this server — a disallowed origin's request is still
# processed and answered; the browser just refuses to let the origin's
# JS read the response. This is NOT authentication (use API_KEY above
# for that) and does not protect non-browser clients (curl, scripts),
# which never consult CORS at all.
#
# A Chrome extension's own `host_permissions` (extension/manifest.json)
# is a SEPARATE mechanism: it gates whether the extension's content
# script may attempt the fetch in the first place, before CORS is even
# consulted. Both must allow a request for it to succeed end-to-end.
#
# Safe default: the mock site's own localhost origin (below) — this
# preserves the exact scope this project has always used.
# Development value: the default is fine for the mock site.
# Hosted value: the origin(s) of the actual page(s) the extension will
# run on. Do not use a wildcard (`*`) for a hosted deployment unless a
# real requirement demands it — a wildcard here means ANY website's
# JavaScript could read this server's responses if it ever obtained a
# valid API key from elsewhere.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
