{
  "manifest_version": 3,
  "name": "PrivyVision — Privacy-Preserving Browser Agent",
  "version": "0.1.0",
  "description": "SIH26171 prototype: local perception and redaction run before any network request leaves the browser.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["dist/vision-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dist/ort.all.min.js",
        "dist/ort-wasm-simd-threaded.jsep.mjs",
        "dist/ort-wasm-simd-threaded.jsep.wasm",
        "dist/ort-wasm-simd-threaded.mjs",
        "dist/ort-wasm-simd-threaded.wasm",
        "dist/models/face-detector.onnx"
      ],
      "matches": ["http://localhost/*", "http://127.0.0.1/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
