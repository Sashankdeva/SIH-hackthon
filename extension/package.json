{
  "name": "privyvision-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "vitest run src/",
    "test:integration": "node esbuild.test.config.mjs && node --test \"dist-tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^26.4.0",
    "esbuild": "^0.23.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "onnxruntime-web": "^1.29.0"
  }
}
